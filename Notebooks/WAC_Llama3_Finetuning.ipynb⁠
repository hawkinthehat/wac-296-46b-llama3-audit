        "!pip install pypdf\n",
        "\n",
        "import re\n",
        "import json\n",
        "from pypdf import PdfReader\n",
        "\n",
        "# Load the uploaded WAC PDF\n",
        "pdf_path = \"F500-142-000.pdf\"\n",
        "reader = PdfReader(pdf_path)\n",
        "\n",
        "full_text = \"\"\n",
        "for page in reader.pages:\n",
        "    text = page.extract_text()\n",
        "    if text:\n",
        "        full_text += text + \"\\n\"\n",
        "\n",
        "# Regex split by WAC section headers (e.g., WAC 296-46B-210)\n",
        "wac_sections = re.split(r'(WAC\\s+296-46B-\\d+)', full_text)\n",
        "\n",
        "chunks = []\n",
        "for i in range(1, len(wac_sections), 2):\n",
        "    section_title = wac_sections[i].strip()\n",
        "    section_body = wac_sections[i+1].strip() if (i+1) < len(wac_sections) else \"\"\n",
        "\n",
        "    # Store clean chunks of text under 2000 chars for prompt generation\n",
        "    if len(section_body) > 50:\n",
        "        chunks.append({\n",
        "            \"section\": section_title,\n",
        "            \"content\": section_body[:2500]  # First 2500 characters of section rules\n",
        "        })\n",
        "\n",
        "print(f\"Successfully extracted {len(chunks)} WAC code rule blocks!\")\n",
        "\n",
        "# Save extracted chunks locally\n",
        "with open(\"wac_chunks.json\", \"w\") as f:\n",
        "    json.dump(chunks, f, indent=2)\n"
