        "import json\n",
        "from google.colab import userdata\n",
        "from openai import OpenAI\n",
        "\n",
        "# 1. Initialize OpenAI client securely\n",
        "client = OpenAI(api_key=userdata.get('OPENAI_API_KEY'))\n",
        "\n",
        "# 2. Grab your completed batch job\n",
        "batches = client.batches.list(limit=1)\n",
        "batch_job = batches.data[0]\n",
        "\n",
        "print(f\"Retrieving Output for Batch ID: {batch_job.id}\")\n",
        "\n",
        "# 3. Pull results and reconstruct training file\n",
        "result_file_id = batch_job.output_file_id\n",
        "content = client.files.content(result_file_id).content.decode(\"utf-8\")\n",
        "\n",
        "training_pairs = []\n",
        "for line in content.strip().split(\"\\n\"):\n",
        "    data = json.loads(line)\n",
        "    response_text = data[\"response\"][\"body\"][\"choices\"][0][\"message\"][\"content\"]\n",
        "\n",
        "    training_entry = {\n",
        "        \"messages\": [\n",
        "            {\"role\": \"system\", \"content\": \"You are a Washington State electrical compliance expert specializing in WAC 296-46B and NEC 2023 code enforcement.\"},\n",
        "            {\"role\": \"user\", \"content\": f\"Analyze compliance requirements for this scenario:\\n{response_text[:300]}\"},\n",
        "            {\"role\": \"assistant\", \"content\": response_text}\n",
        "        ]\n",
        "    }\n",
        "    training_pairs.append(training_entry)\n",
        "\n",
        "# 4. Save file back to GPU session storage\n",
        "with open(\"wac_finetune_dataset.jsonl\", \"w\") as f:\n",
        "    for pair in training_pairs:\n",
        "        f.write(json.dumps(pair) + \"\\n\")\n",
        "\n",
        "print(f\"Re-created 'wac_finetune_dataset.jsonl' with {len(training_pairs)} entries on T4 GPU instance.\")\n"
