      "source": [
        "import json\n",
        "import torch\n",
        "from google.colab import userdata\n",
        "from openai import OpenAI\n",
        "from unsloth import FastLanguageModel\n",
        "from datasets import load_dataset\n",
        "from trl import SFTTrainer\n",
        "from transformers import TrainingArguments\n",
        "\n",
        "# 1. Fetch raw batch results directly from OpenAI\n",
        "client = OpenAI(api_key=userdata.get('OPENAI_API_KEY'))\n",
        "batches = client.batches.list(limit=1)\n",
        "batch_job = batches.data[0]\n",
        "\n",
        "print(f\"Fetching raw output for Batch ID: {batch_job.id}\")\n",
        "result_file_id = batch_job.output_file_id\n",
        "raw_content = client.files.content(result_file_id).content.decode(\"utf-8\")\n",
        "\n",
        "# 2. Scrub meta-headers and construct clean Q&A training pairs\n",
        "clean_pairs = []\n",
        "for line in raw_content.strip().split(\"\\n\"):\n",
        "    data = json.loads(line)\n",
        "    raw_text = data[\"response\"][\"body\"][\"choices\"][0][\"message\"][\"content\"]\n",
        "\n",
        "    sections = raw_text.split(\"### \")\n",
        "    for section in sections:\n",
        "        if not section.strip():\n",
        "            continue\n",
        "\n",
        "        lines = section.strip().split(\"\\n\")\n",
        "        title = lines[0]\n",
        "        body = \"\\n\".join(lines[1:]).strip()\n",
        "\n",
        "        clean_entry = {\n",
        "            \"messages\": [\n",
        "                {\n",
        "                    \"role\": \"system\",\n",
        "                    \"content\": \"You are an expert Washington State electrical compliance auditor. Evaluate installation scenarios under WAC 296-46B amendments and NEC 2023 code.\"\n",
        "                },\n",
        "                {\n",
        "                    \"role\": \"user\",\n",
        "                    \"content\": f\"Evaluate this installation scenario:\\n{title}\\n{body[:250]}\"\n",
        "                },\n",
        "                {\n",
        "                    \"role\": \"assistant\",\n",
        "                    \"content\": body\n",
        "                }\n",
        "            ]\n",
        "        }\n",
        "        clean_pairs.append(clean_entry)\n",
        "\n",
        "# Save cleaned dataset locally\n",
        "with open(\"wac_finetune_dataset.jsonl\", \"w\") as f:\n",
        "    for pair in clean_pairs:\n",
        "        f.write(json.dumps(pair) + \"\\n\")\n",
        "\n",
        "print(f\"Dataset ready: {len(clean_pairs)} clean Q&A pairs saved to 'wac_finetune_dataset.jsonl'.\")\n",
        "\n",
        "# 3. Setup Unsloth model on GPU\n",
        "max_seq_length = 1024\n",
        "dtype = None\n",
        "load_in_4bit = True\n",
        "\n",
        "model, tokenizer = FastLanguageModel.from_pretrained(\n",
        "    model_name = \"unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit\",\n",
        "    max_seq_length = max_seq_length,\n",
        "    dtype = dtype,\n",
        "    load_in_4bit = load_in_4bit,\n",
        "    device_map = {\"\": 0}\n",
        ")\n",
        "\n",
        "model = FastLanguageModel.get_peft_model(\n",
        "    model,\n",
        "    r = 16,\n",
        "    target_modules = [\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n",
        "                      \"gate_proj\", \"up_proj\", \"down_proj\"],\n",
        "    lora_alpha = 16,\n",
        "    lora_dropout = 0,\n",
        "    bias = \"none\",\n",
        "    use_gradient_checkpointing = \"unsloth\",\n",
        "    random_state = 3407,\n",
        ")\n",
        "\n",
        "# 4. Format and load dataset\n",
        "dataset = load_dataset(\"json\", data_files=\"wac_finetune_dataset.jsonl\", split=\"train\")\n",
        "\n",
        "def formatting_prompts_func(examples):\n",
        "    convs = examples[\"messages\"]\n",
        "    texts = [tokenizer.apply_chat_template(convo, tokenize=False, add_generation_prompt=False) for convo in convs]\n",
        "    return { \"text\" : texts }\n",
        "\n",
        "dataset = dataset.map(formatting_prompts_func, batched = True)\n",
        "\n",
        "# 5. Train model\n",
        "trainer = SFTTrainer(\n",
        "    model = model,\n",
        "    tokenizer = tokenizer,\n",
        "    train_dataset = dataset,\n",
        "    dataset_text_field = \"text\",\n",
        "    max_seq_length = max_seq_length,\n",
        "    dataset_num_proc = 2,\n",
        "    packing = False,\n",
        "    args = TrainingArguments(\n",
        "        per_device_train_batch_size = 1,\n",
        "        gradient_accumulation_steps = 4,\n",
        "        warmup_steps = 5,\n",
        "        max_steps = 60,\n",
        "        learning_rate = 2e-4,\n",
        "        fp16 = not torch.cuda.is_bf16_supported(),\n",
        "        bf16 = torch.cuda.is_bf16_supported(),\n",
        "        logging_steps = 1,\n",
        "        optim = \"adamw_8bit\",\n",
        "        weight_decay = 0.01,\n",
        "        lr_scheduler_type = \"linear\",\n",
        "        seed = 3407,\n",
        "        output_dir = \"outputs\",\n",
        "    ),\n",
        ")\n",
        "\n",
        "trainer_stats = trainer.train()\n",
        "\n",
        "# 6. Export LoRA weights and 4-bit GGUF binary\n",
        "model.save_pretrained(\"wac_llama3_lora_clean\")\n",
        "tokenizer.save_pretrained(\"wac_llama3_lora_clean\")\n",
        "\n",
        "model.save_pretrained_gguf(\"wac_llama3_8b_q4km\", tokenizer, quantization_method = \"q4_k_m\")\n",
        "\n",
        "print(\"\\n==========================================\")\n",
        "print(\"CLEAN TRAINING & GGUF EXPORT COMPLETE!\")\n",
        "print(\"Saved binary to 'wac_llama3_8b_q4km/unsloth.Q4_K_M.gguf'\")\n",
        "print(\"==========================================\")\n"
      ],
